    "generate-blog": "node src/modules/blog/blog.generator.js",
    "seed:jobs": "node scripts/seed-jobs.js",
    "test:deepai": "node scripts/test-deepai.js",
    "test:runware": "node scripts/test-runware.js",
    "test:ultra-magic": "node scripts/test-ultra-magic-v2.js",
    "quick-test": "node scripts/quick-test.js",
    "run-scheduler": "node scripts/run-scheduler-now.js",
    "dominate": "node scripts/full-domination.js",
    "dominate:10": "node scripts/full-domination.js 10",
    "dominate:25": "node scripts/full-domination.js 25",
    "dominate:50": "node scripts/full-domination.js 50",
